[app]
environment = "development"
local_user_email = "ana@example.org"
auth_provider = "auth0"

[access]
approved_emails = ["ana@example.org"]

[database]
url = "sqlite:///data/protein_ccs.db"

# Production authentication example. Keep real values in Streamlit's Secrets
# settings, never in this repository.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-value"

[auth.auth0]
client_id = "replace-me"
client_secret = "replace-me"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
